# TgStrm stores all mutable application data here. Keep this directory private
# and back it up with its master.key and database.enc together.
TGSTRM_DATA_DIR=./data

# Default: only this machine can reach TgStrm. Keep this setting for local-only use.
TGSTRM_ADDR=127.0.0.1:5151

# To allow LAN clients or a reverse proxy to reach the process, set both:
# TGSTRM_ADDR=0.0.0.0:5151
# TGSTRM_ALLOW_REMOTE=1

# Comma-separated CIDRs for the *actual* reverse-proxy network. This permits
# Secure cookies when Nginx Proxy Manager forwards X-Forwarded-Proto: https.
# Never use 0.0.0.0/0 here.
# TGSTRM_TRUSTED_PROXY_CIDRS=172.18.0.0/16

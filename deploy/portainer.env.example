# Replace with the package that the GitHub release workflow publishes.
TGSTRM_IMAGE=ghcr.io/REPLACE_WITH_GITHUB_OWNER/tgstrm:latest

# App state stays on the installation disk. It is separate from the libraries.
TGSTRM_DATA_DIR_HOST=/instalaciones/tgstrm/data

# Library targets. In the TgStrm web settings, use /media/movies and
# /media/shows, because those are the paths visible inside the container.
TGSTRM_MOVIES_DIR_HOST=/extraible2/strm/movies
TGSTRM_SHOWS_DIR_HOST=/extraible2/strm/series

# Keep the port private when NPM runs on the host. For a Docker-only NPM setup,
# use a private shared network and the service name tgstrm as upstream.
TGSTRM_BIND_ADDRESS=127.0.0.1
TGSTRM_PORT=5151

# Obtain from: docker network inspect YOUR_NPM_NETWORK
# Example only; use the actual subnet and never 0.0.0.0/0.
TGSTRM_TRUSTED_PROXY_CIDRS=172.18.0.0/16

# Only used by compose.portainer.npm.yml. It must be the pre-existing Docker
# network to which the Nginx Proxy Manager container is attached.
TGSTRM_NPM_NETWORK=npm_default

# Ownership used by the container for /data and both library directories.
PUID=1000
PGID=1000

# Advanced deployment variables. For the standard compose.yaml Stack, use the
# root .env.example instead.

# Optional: defaults to ghcr.io/anubisreal/tgstrm:latest in all templates.
# TGSTRM_IMAGE=ghcr.io/anubisreal/tgstrm:latest

# Required only by the advanced bundled-PostgreSQL variants. Set a unique,
# high-entropy value directly in Portainer; never commit or reuse a real one.
# POSTGRES_PASSWORD is only for the database administrator; do not enter it in TgStrm.
# POSTGRES_PASSWORD=
# TGSTRM_DATABASE_PASSWORD=

# App state stays on the installation disk. It is separate from the libraries.
TGSTRM_DATA_DIR_HOST=/instalaciones/tgstrm/data

# Library targets. In the TgStrm web settings, use /media/movies and
# /media/shows, because those are the paths visible inside the container.
TGSTRM_MOVIES_DIR_HOST=/extraible2/strm/movies
TGSTRM_SHOWS_DIR_HOST=/extraible2/strm/series

# Published host port. NPM points to the server LAN IP and this port.
# The container always listens on 5151. Change this value if the host port is busy.
TGSTRM_PORT=5151

# Optional when NPM runs in Docker: set its real source subnet (inspect its
# Docker network), never a guessed subnet or 0.0.0.0/0.
# TGSTRM_TRUSTED_PROXY_CIDRS=172.18.0.0/16

# Only the legacy shared-network variants in deploy/ use TGSTRM_NPM_NETWORK.

# Ownership used by the container for /data and both library directories.
PUID=1000
PGID=1000

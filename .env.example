# TgStrm standard Stack configuration.
# Docker CLI: copy this file to .env beside compose.yaml.
# Portainer: use "Load variables from .env file" and upload this file after
# completing the two passwords. Never commit a real .env file.

# Required. Use two unique, long passwords. Leaving either one empty makes the
# Stack stop before creating an insecure database.
POSTGRES_PASSWORD=
TGSTRM_DATABASE_PASSWORD=

# Persistent application state. Keep this path unchanged during updates.
TGSTRM_DATA_DIR_HOST=/instalaciones/tgstrm/data

# STRM library destinations. Configure /media/movies and /media/shows in the
# TgStrm web panel: those are the paths seen inside the container.
TGSTRM_MOVIES_DIR_HOST=/extraible2/strm/movies
TGSTRM_SHOWS_DIR_HOST=/extraible2/strm/series

# LAN port exposed by the server. Change only this value when 5151 is occupied.
TGSTRM_PORT=5151

# Owner of the three host directories above. 1000:1000 is common on Linux;
# change it if those directories belong to another user.
PUID=1000
PGID=1000

# Optional: defaults to ghcr.io/anubisreal/tgstrm:latest.
# TGSTRM_IMAGE=ghcr.io/anubisreal/tgstrm:latest
